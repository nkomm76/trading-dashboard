# Datenbank (Hostinger: MySQL-Datenbank im hPanel anlegen)
DATABASE_URL="mysql://USER:PASSWORT@HOST:3306/DATENBANK"
# Nur lokal für "prisma migrate dev" nötig
SHADOW_DATABASE_URL="mysql://USER:PASSWORT@localhost:3306/dividenden_shadow"

# Mindestens 32 zufällige Zeichen, z. B. mit: openssl rand -hex 32
SESSION_PASSWORD=""
# Geheimnis für den Cronjob-Aufruf, z. B.: openssl rand -hex 24
CRON_SECRET=""
# Wird von "npm run set-password" erzeugt
ADMIN_PASSWORD_HASH_B64=""

# SEC verlangt eine Kennung im User-Agent
SEC_USER_AGENT="dividenden-dashboard privat"

# Optional: KI-Auswertung des Ausblicks (ohne Key bleibt die Ampel regelbasiert)
ANTHROPIC_API_KEY=""
# OUTLOOK_MODEL="claude-sonnet-5-5"

# Optional: kostenloser Eulerpool-Schlüssel (eulerpool.com/developers/register) für längere Jahreshistorie im Aktien Check
EULERPOOL_API_KEY=""
