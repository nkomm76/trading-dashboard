generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Stock {
  id        Int        @id @default(autoincrement())
  symbol    String     @unique @db.VarChar(32) // Yahoo-Symbol, z. B. JNJ oder ALV.DE
  isin      String?    @db.VarChar(12)
  name      String     @db.VarChar(255)
  exchange  String?    @db.VarChar(64)
  currency  String     @db.VarChar(8)
  sector    String?    @db.VarChar(128)
  cik       String?    @db.VarChar(10) // SEC-Kennung, nur US-Werte
  assetClass AssetClass @default(STOCK) // Aktie, ETF oder Krypto; bestimmt Ampel und Gruppierung
  createdAt DateTime   @default(now())
  purchases Purchase[]
  snapshots Snapshot[]
  outlooks  Outlook[]
  ratings   Rating[]
  dividends Dividend[]
}

enum AssetClass {
  STOCK
  ETF
  CRYPTO
}

// Barbestand als eingetragener Kontostand; frühere Stände bleiben für den Vermögensverlauf erhalten
model CashBalance {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  amount    Decimal  @db.Decimal(18, 2) // EUR
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now())
}

enum TxType {
  BUY
  SELL
}

// Kauf oder Verkauf einer Aktie
model Purchase {
  id        Int      @id @default(autoincrement())
  type      TxType   @default(BUY)
  stockId   Int
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  price     Decimal  @db.Decimal(18, 6) // in Handelswährung der Aktie
  quantity  Decimal  @db.Decimal(24, 10) // Krypto braucht 8 Nachkommastellen (Satoshi)
  fees      Decimal  @default(0) @db.Decimal(18, 6) // in EUR
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([stockId])
}

// Ein Datenstand je Aktie und Tag. Jeder Wert ist optional: fehlt eine Quelle, bleibt er null.
model Snapshot {
  id        Int      @id @default(autoincrement())
  stockId   Int
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  metrics   Json // Kennzahlen inkl. Quelle, Stichtag und Periode je Wert
  series    Json // Zeitreihen für Charts (Dividenden, EPS, FCF)
  createdAt DateTime @default(now())

  @@unique([stockId, date])
}

enum GuidanceStatus {
  RAISED
  CONFIRMED
  LOWERED
  UNKNOWN
}

model Outlook {
  id           Int            @id @default(autoincrement())
  stockId      Int
  stock        Stock          @relation(fields: [stockId], references: [id], onDelete: Cascade)
  period       String         @db.VarChar(16) // Berichtsperiode, z. B. 2026-06-30
  status       GuidanceStatus
  dividendCut  Boolean        @default(false)
  summary      Json // Kernaussagen (Liste)
  risks        Json // Risiken (Liste)
  sources      Json // [{ title, url }]
  model        String         @db.VarChar(64)
  createdAt    DateTime       @default(now())

  @@unique([stockId, period])
}

enum Light {
  GREEN
  ORANGE
  RED
  GREY
}

model Rating {
  id        Int      @id @default(autoincrement())
  stockId   Int
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  light     Light
  reasons   Json // [{ criterion, light, text }]
  createdAt DateTime @default(now())

  @@unique([stockId, date])
}

model Setting {
  key   String @id @db.VarChar(64)
  value Json
}

model RefreshLog {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  message    String?   @db.Text
}

enum DividendStatus {
  CONFIRMED
  DISMISSED
}

// Erhaltene (bestätigte) oder bewusst ignorierte Dividendenzahlung je Ex-Tag
model Dividend {
  id        Int            @id @default(autoincrement())
  stockId   Int
  stock     Stock          @relation(fields: [stockId], references: [id], onDelete: Cascade)
  exDate    DateTime       @db.Date
  status    DividendStatus @default(CONFIRMED)
  quantity  Decimal?       @db.Decimal(18, 6) // Stück am Ex-Tag
  perShare  Decimal?       @db.Decimal(18, 6) // je Aktie in Handelswährung (laut Quelle)
  grossEur  Decimal?       @db.Decimal(18, 2)
  netEur    Decimal?       @db.Decimal(18, 2) // Gutschrift laut Abrechnung
  note      String?        @db.VarChar(255)
  createdAt DateTime       @default(now())

  @@unique([stockId, exDate])
}

// Beobachtete Aktie mit dem letzten Ergebnis aus dem Aktien Check
model WatchItem {
  id        Int       @id @default(autoincrement())
  symbol    String    @unique @db.VarChar(32)
  isin      String?   @db.VarChar(12)
  name      String    @db.VarChar(255)
  currency  String    @db.VarChar(8)
  light     Light?
  summary   Json? // Kurzfassung: Kriterien, Kurs, faire Werte
  checkedAt DateTime?
  error     String?   @db.VarChar(255) // letzter Fehler beim Aktualisieren
  createdAt DateTime  @default(now())
}
